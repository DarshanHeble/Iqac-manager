# =============================================================================
# IQAC Manager — environment for `./setup.sh` and `./run.sh`.
#
# Compose reads this file and injects the values as real environment variables.
# It is NOT copied into any image, which matters: the backend calls
# load_dotenv(override=True), so a .env inside the container would silently
# override these settings.
#
# ./setup.sh creates this file from this template and replaces the two marked
# values with generated secrets. Edit the rest as needed.
#
# Inventory of every variable the backend reads:
#   documents/backend/data/env-vars.json
# =============================================================================

# --- secrets (setup.sh generates these) ---------------------------------------
# Signs the session cookie, which carries username, active role and
# must_change_password. The app falls back to the literal "your_secret_key" if
# this is unset — which makes every session forgeable by anyone who has read the
# source. Do not leave it blank.
SECRET_KEY=replace_me_setup_sh_generates_this

# Local PostgreSQL password. Also embedded in DATABASE_URL below.
POSTGRES_PASSWORD=replace_me_setup_sh_generates_this

# --- database -----------------------------------------------------------------
POSTGRES_USER=iqac
POSTGRES_DB=iqac

# ⚠  Changing POSTGRES_PASSWORD after `./run.sh` has created the volume does
#    NOTHING. Postgres stores the password the database was initialised with, so
#    editing it here only breaks the connection (the backend then 500s on every
#    database-backed request). To change it: `./run.sh down && ./run.sh destroy`,
#    then edit this file and start again — that deletes all data.
# Assembled by docker-compose.yml; do not set by hand. Kept here for reference:
# DATABASE_URL=postgresql://iqac:<POSTGRES_PASSWORD>@db:5432/iqac
#
# The connection is retried with sslmode=require, then prefer, then disable, so a
# plain local container works on the third attempt.

# --- published ports ----------------------------------------------------------
# Change these if something already listens on them. `5432` is deliberately not
# published; use `./run.sh db` instead.
FRONTEND_PORT=8080
BACKEND_PORT=5000

# --- Cloudinary (REQUIRED — the app will not start without these) ------------
# backend/app.py:41-47 calls cloudinary.config() unguarded, so a missing value
# raises AttributeError at import and the container never boots. The placeholder
# values below are enough to boot; uploads will fail until you set real ones.
CLOUDINARY_CLOUD_NAME=demo
CLOUDINARY_API_KEY=replace_me
CLOUDINARY_API_SECRET=replace_me

# --- AI providers (optional) --------------------------------------------------
# Both are guarded, so the app boots without them. With neither set, the AI
# summary endpoint returns the worklog unsummarised and says so.
# GEMINI_API_KEY=
# NVIDIA_API_KEY=
NVIDIA_MODEL_NAME=meta/llama-3.1-8b-instruct

# --- email (optional) ---------------------------------------------------------
# Used for temporary-password emails and the daily coordinator reminder.
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_EMAIL=
# SMTP_PASSWORD=
# SENDER_EMAIL=

# --- report generation (optional) ---------------------------------------------
# Comma-separated. Overrides the hardcoded AQAR coordinator list in
# backend/routes/pdf.py when the directory differs at your institution.
# AQAR_COORDINATOR_NAMES=
# AQAR_COORDINATOR_EMAILS=